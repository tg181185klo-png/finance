{
  "files.autoSave": "onFocusChange",
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/.next/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/coverage/**": true,
    "**/out/**": true,
    "**/.vercel/**": true,
    "**/.turbo/**": true,
    "**/.cache/**": true,
    "**/tmp-xlsx/**": true,
    "**/*.tsbuildinfo": true,
    "**/*.log": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/.next": true,
    "**/dist": true,
    "**/build": true,
    "**/coverage": true,
    "**/out": true,
    "**/.vercel": true,
    "**/.turbo": true,
    "**/.cache": true,
    "**/tmp-xlsx": true,
    "**/*.tsbuildinfo": true,
    "**/*.log": true,
    "**/package-lock.json": true
  },
  "typescript.tsserver.maxTsServerMemory": 2048,
  "typescript.disableAutomaticTypeAcquisition": true,
  "typescript.tsserver.watchOptions": {
    "watchFile": "useFsEvents",
    "watchDirectory": "useFsEvents",
    "fallbackPolling": "dynamicPriority",
    "excludeDirectories": [
      "**/node_modules",
      "**/.next",
      "**/dist",
      "**/build",
      "**/coverage",
      "**/out",
      "**/.vercel",
      "**/tmp-xlsx"
    ]
  },
  "terminal.integrated.gpuAcceleration": "on"
}
